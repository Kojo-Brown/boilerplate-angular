{
  "name": "boilerplate-angular",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve:ssr": "node dist/boilerplate-angular/server/server.mjs",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src/ --max-warnings=0",
    "check:onpush": "scripts/ci/assert-onpush-everywhere.sh",
    "check:tracks": "node scripts/ci/assert-for-track.mjs",
    "check:images": "node scripts/ci/assert-image-hygiene.mjs",
    "check:form-types": "node scripts/ci/assert-form-types.mjs",
    "check:fixtures": "node scripts/dev/make-placeholder-images.mjs --check",
    "stats": "ng build --configuration production --stats-json --output-path .stats",
    "check:defer": "node scripts/ci/assert-deferred-chunks.mjs",
    "check:routes": "node scripts/ci/assert-route-budgets.mjs",
    "check:ssr": "node scripts/ci/assert-ssr.mjs",
    "test": "ng test --no-watch --no-progress",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "e2e": "playwright test --project=chromium",
    "e2e:a11y": "playwright test --project=a11y",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@ngrx/operators": "^21.0.0",
    "@ngrx/signals": "^21.0.0",
    "@tanstack/angular-query-experimental": "^5.101.2",
    "express": "^5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "web-vitals": "^6.2.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.5.1",
    "autoprefixer": "^10.4.0",
    "axe-core": "4.13.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "zone.js": "~0.15.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@ngrx/signals>@angular/core": "22"
      }
    }
  }
}
